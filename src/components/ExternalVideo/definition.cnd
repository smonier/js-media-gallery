<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<jsmediagallerynt = 'http://modules.se.jahia.org/mediagal/nt/1.0'>

[jsmediagallerynt:externalVideo] > jnt:content, mix:title
 - videoDesc (string) i18n
 - videoService (string, choicelist[resourceBundle]) = 'youtube' < 'youtube', 'vimeo', 'wistia', 'dailymotion', 'storylane'
 - videoId (string) i18n
 - videoPoster (weakreference, picker[type='image']) < 'jmix:image'
 - transcript (string, richtext) i18n
 - featured (boolean) = false
